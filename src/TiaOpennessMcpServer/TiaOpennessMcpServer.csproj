<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TiaOpennessMcpServer</RootNamespace>
    <AssemblyName>TiaPortalDashboard</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hypermedia.Datastar"                      Version="0.1.0" />
    <PackageReference Include="System.Text.Json"                         Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Siemens.Engineering">
      <HintPath>$(PROGRAMFILES)\Siemens\Automation\Portal V20\PublicAPI\V20\Siemens.Engineering.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Engineering.Hmi">
      <HintPath>$(PROGRAMFILES)\Siemens\Automation\Portal V20\PublicAPI\V20\Siemens.Engineering.Hmi.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Dashboard\wwwroot\index.html;Dashboard\wwwroot\styles.css;Dashboard\wwwroot\datastar.js" />
    <EmbeddedResource Include="Dashboard\wwwroot\index.html" LogicalName="TiaOpennessMcpServer.Dashboard.wwwroot.index.html" />
    <EmbeddedResource Include="Dashboard\wwwroot\styles.css" LogicalName="TiaOpennessMcpServer.Dashboard.wwwroot.styles.css" />
    <EmbeddedResource Include="Dashboard\wwwroot\datastar.js" LogicalName="TiaOpennessMcpServer.Dashboard.wwwroot.datastar.js" />
    <None Update="Dashboard\wwwroot\DATASTAR-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="..\..\data\technology-object-catalogue.json" Link="technology-object-catalogue.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
