<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\write-operations.md" LogicalName="write-operations.md" />
    <EmbeddedResource Include="..\..\docs\user-manual.md" LogicalName="user-manual.md" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Mcp\McpBoundary.cs" Link="Production\Mcp\McpBoundary.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Mcp\McpContracts.cs" Link="Production\Mcp\McpContracts.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Mcp\McpRpcProcessor.cs" Link="Production\Mcp\McpRpcProcessor.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Host\LoopbackOriginPolicy.cs" Link="Production\Host\LoopbackOriginPolicy.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Operations\*.cs" Link="Production\Operations\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Services\ConnectionContracts.cs" Link="Production\Services\ConnectionContracts.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Services\ConnectionRegistry.cs" Link="Production\Services\ConnectionRegistry.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Services\ConnectionSnapshot.cs" Link="Production\Services\ConnectionSnapshot.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Services\EngineeringService.cs" Link="Production\Services\EngineeringService.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Utilities\StaTaskScheduler.cs" Link="Production\Utilities\StaTaskScheduler.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Diagnostics\*.cs" Link="Production\Diagnostics\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Dashboard\DashboardHistory.cs" Link="Production\Dashboard\DashboardHistory.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Dashboard\DashboardService.cs" Link="Production\Dashboard\DashboardService.cs" />
    <Compile Include="..\..\src\TiaOpennessMcpServer\Dashboard\DashboardToolForms.cs" Link="Production\Dashboard\DashboardToolForms.cs" />
  </ItemGroup>

</Project>
